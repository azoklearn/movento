{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/addons.js": {
      "maxDuration": 60
    },
    "api/customize.js": {
      "maxDuration": 300
    }
  }
}
